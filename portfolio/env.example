# 環境變數範本
# 請複製此檔案為 .env.local 並設定正確的值

# Strapi CMS 的 URL
# 開發環境通常是：http://localhost:1337
# 生產環境請設定為實際的 Strapi 伺服器 URL
VITE_STRAPI_URL=http://localhost:1337

# EmailJS 配置（聯絡表單發送郵件）
# 前往 https://www.emailjs.com/ 註冊並取得以下資訊：
# 1. Service ID：在 Email Services 中取得
# 2. Template ID：在 Email Templates 中取得
# 3. Public Key：在 Account > General 中取得
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# 使用方式：
# 1. 複製此檔案：cp env.example .env.local
# 2. 修改 .env.local 中的值為正確的設定
# 3. 重新啟動開發伺服器：npm run dev
