# 環境變數範本
# 請複製此檔案為 .env.local 並設定正確的值

# Strapi CMS 的 URL
# 開發環境透過 Vite proxy 走同源路徑，避免自簽憑證被瀏覽器阻擋
VITE_STRAPI_URL=/strapi

# 使用方式：
# 1. 複製此檔案：cp env.example .env.local
# 2. 修改 .env.local 中的 VITE_STRAPI_URL 為正確的值
# 3. 重新啟動開發伺服器：npm run dev

# EmailJS 設定
VITE_EMAILJS_SERVICE_ID=service_v922dsx
VITE_EMAILJS_TEMPLATE_ID=template_rsuwk4o
VITE_EMAILJS_PUBLIC_KEY=zxu3NTZBZD1EWJUEY
