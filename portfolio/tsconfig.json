{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "hds": ["../harryds/src/index.ts"],
      "hds/*": ["../harryds/src/*"],
      "@hds/*": ["../harryds/src/*"],
      "shared": ["../shared"],
      "shared/*": ["../shared/*"]
    },
    "strict": true
  },
  "include": ["src"]
}


