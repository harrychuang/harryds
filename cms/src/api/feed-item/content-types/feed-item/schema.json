{
  "kind": "collectionType",
  "collectionName": "feed_items",
  "info": {
    "singularName": "feed-item",
    "pluralName": "feed-items",
    "displayName": "Feed Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "string",
      "required": true
    },
    "tags": {
      "type": "json"
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "project",
        "article"
      ]
    },
    "brand": {
      "type": "string"
    },
    "primaryColor": {
      "type": "string"
    },
    "secondaryColor": {
      "type": "string"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "feed.paragraph",
        "feed.list",
        "feed.image",
        "feed.heading",
        "feed.video"
      ]
    }
  }
}
