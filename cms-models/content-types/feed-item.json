{
  "kind": "collectionType",
  "collectionName": "feed_items",
  "info": {
    "singularName": "feed-item",
    "pluralName": "feed-items",
    "displayName": "Feed Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "heading": { "type": "string", "required": true },
    "date": { "type": "string", "required": true },
    "tags": { "type": "json" },
    "category": { "type": "enumeration", "enum": ["project", "article"], "required": true },
    "brand": { "type": "string" },
    "primaryColor": { "type": "string" },
    "secondaryColor": { "type": "string" },
    "heroImage": { "type": "media", "multiple": false },
    "content": {
      "type": "dynamiczone",
      "components": [
        "feed.heading",
        "feed.paragraph",
        "feed.image",
        "feed.list"
      ]
    }
  }
}


